                    <!-- ========================================================= -->
                    <!-- TAB 4: STUDIO MICRO & VST (ZERO AI) -->
                    <!-- ========================================================= -->
                    <TabItem x:Name="TabMic" Header="🎙️  Studio Micro &amp; VST">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,10,0,20" MaxWidth="800" HorizontalAlignment="Center">
                                <TextBlock Text="🎙️ Chaine Vocale Studio &amp; Rack de Plugins VST3" FontSize="16" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                <TextBlock Text="Traitement DSP Hardware haute fidélité (0.1 ms) · Zero IA lourde · Hébergement de plugins VST3 pour microphone." Foreground="#94A3B8" Margin="0,0,0,16"/>

                                <!-- 1. CLEARCAST AI NOISE CANCELLATION CARD -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="🌊 CLEARCAST AI NOISE CANCELLATION" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
                                                <TextBlock Text="Annulation de bruit par intelligence artificielle avec ajustement du mélange." FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkClearCastAi" Grid.Column="1" VerticalAlignment="Center" IsChecked="True" Checked="ChkClearCastAi_Checked" Unchecked="ChkClearCastAi_Unchecked"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Min" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Slider x:Name="SliderClearCastAi" Grid.Column="1" Minimum="0" Maximum="1" Value="0.65" SmallChange="0.05" LargeChange="0.1" ValueChanged="SliderClearCastAi_ValueChanged"/>
                                            <TextBlock Text="Max" Grid.Column="2" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="TxtClearCastAiVal" Text="65%" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#6366F1" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- DSP Voice Processing Card -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Traitement Vocal Direct (Noise Gate &amp; Dynamique)" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14" Margin="0,0,0,14"/>

                                        <!-- 1. Noise Gate -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="NOISE GATE (Porte Anti-Bruit)" FontWeight="Bold" Foreground="#E2E8F0"/>
                                                <TextBlock Text="Coupe automatiquement le micro quand vous ne parlez pas (clavier, ventilateurs)." FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                            <Border x:Name="BadgeGateStatus" Grid.Column="1" Background="#1A2D24" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock x:Name="TxtGateStatus" Text="🟢 PORTE OUVERTE" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                            </Border>
                                            <CheckBox x:Name="ChkNoiseGate" Grid.Column="2" VerticalAlignment="Center" IsChecked="True" Checked="ChkNoiseGate_Checked" Unchecked="ChkNoiseGate_Unchecked"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,14">
                                            <Slider x:Name="SliderNoiseGate" Minimum="-60" Maximum="-15" Value="-45.7" SmallChange="0.5" ValueChanged="SliderNoiseGate_ValueChanged"/>
                                            <TextBlock x:Name="TxtNoiseGateVal" Text="-45.7 dB" HorizontalAlignment="Right" Margin="0,-20,0,0" FontWeight="Bold" Foreground="#FF5500"/>
                                        </Grid>

                                        <Separator Background="#212839" Margin="0,4,0,14"/>

                                        <!-- 2. Studio Compressor -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Compresseur Vocal Studio (Voice Dynamics)" FontWeight="Bold" Foreground="#E2E8F0"/>
                                                <TextBlock Text="Régularise le niveau vocal : les chuchotements restent clairs et les cris ne saturent pas." FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkCompressor" Grid.Column="1" VerticalAlignment="Center" Checked="ChkCompressor_Checked" Unchecked="ChkCompressor_Unchecked" IsChecked="False"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,14">
                                            <Slider x:Name="SliderCompressor" Minimum="-40" Maximum="0" Value="0" ValueChanged="SliderCompressor_ValueChanged"/>
                                            <TextBlock x:Name="TxtCompressorVal" Text="0.0 dB (Seuil)" HorizontalAlignment="Right" Margin="0,-20,0,0" FontWeight="Bold" Foreground="#00B4D8"/>
                                        </Grid>

                                        <Separator Background="#212839" Margin="0,4,0,14"/>

                                        <!-- 3. High Pass & Limiter Row -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- High Pass -->
                                            <Border Background="#10141F" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="Filtre Coupe-Bas (80 Hz)" FontWeight="Bold" Foreground="#E2E8F0"/>
                                                        <CheckBox x:Name="ChkHighPass" HorizontalAlignment="Right" IsChecked="True" Checked="ChkHighPass_Checked" Unchecked="ChkHighPass_Unchecked"/>
                                                    </Grid>
                                                    <TextBlock Text="Supprime les coups de bureau et bruits d'air sourds." FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Limiter -->
                                            <Border Grid.Column="1" Background="#10141F" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="10" Padding="12" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="Limiteur Anti-Saturation" FontWeight="Bold" Foreground="#E2E8F0"/>
                                                        <CheckBox x:Name="ChkLimiter" HorizontalAlignment="Right" IsChecked="True"/>
                                                    </Grid>
                                                    <TextBlock Text="Crête max à -1 dBFS pour protéger l'ouïe de vos coéquipiers." FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- VST3 Plugins Rack Card -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="🎛️ Rack de Plugins VST3 pour Microphone" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
                                                <TextBlock Text="Insérez vos effets audio VST favoris (ReaEQ, FabFilter, Noise Gate VST, WAVES, Elgato...)" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button x:Name="BtnScanVst" Content="🔍 Scanner PC" Style="{StaticResource ActionButton}" Padding="10,5" Margin="0,0,8,0" Click="BtnScanVst_Click"/>
                                                <Button x:Name="BtnAddVst" Content="➕ Ajouter VST3..." Style="{StaticResource PrimaryButton}" Padding="12,5" Click="BtnAddVst_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Quick Presets -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Text="Profils Rapides :" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="⭐ Mon Mix (Broadcast + GG)" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Padding="10,5" Click="BtnPresetUserMix_Click" Background="#4338CA" BorderBrush="#6366F1"/>
                                            <Button Content="🎙️ Broadcast Pro" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Padding="8,4" Click="BtnPresetBroadcast_Click"/>
                                            <Button Content="🎮 Discord Clear" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Padding="8,4" Click="BtnPresetDiscord_Click"/>
                                            <Button Content="📻 Podcast Chaud" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Padding="8,4" Click="BtnPresetPodcast_Click"/>
                                            <Button Content="⚡ Brut (Bypass)" Style="{StaticResource ActionButton}" Padding="8,4" Click="BtnPresetBypass_Click"/>
                                        </StackPanel>

                                        <!-- Active VST Rack Container -->
                                        <StackPanel x:Name="PanelVstRack">
                                            <!-- Injected dynamically in code-behind or default empty prompt -->
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Sidetone Monitoring Card -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="🎧 Écoute en Direct du Micro (Sidetone / Retour Casque)" FontWeight="Bold" Foreground="#E2E8F0"/>
                                            <TextBlock Text="Écoutez instantanément votre propre voix traitée dans le casque sans décalage." FontSize="11" Foreground="#64748B" Margin="0,2,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Volume Retour :" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                                <Slider x:Name="SliderSidetone" Width="180" Minimum="0" Maximum="100" Value="70" ValueChanged="SliderSidetone_ValueChanged"/>
                                                <TextBlock x:Name="TxtSidetoneVal" Text="70%" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="BtnSidetoneToggle" Grid.Column="1" Content="🎧 ÉCOUTER" Style="{StaticResource ActionButton}" Width="100" Height="36" VerticalAlignment="Center" Click="BtnSidetoneToggle_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========================================================= -->
                    <!-- TAB 5: SPATIAL AUDIO 7.1 -->
                    <!-- ========================================================= -->
                    <TabItem x:Name="TabSpatial" Header="🌐  Spatial Audio 7.1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,14,0,0" MaxWidth="720" HorizontalAlignment="Center">
                                <TextBlock Text="Spatial Audio &amp; Virtual Surround 7.1" FontSize="16" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                                <TextBlock Text="Spatialisation sonore avancée 360° pour repérer précisément les bruits de pas et tirs." Foreground="#94A3B8" Margin="0,0,0,20"/>

                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="16" Padding="24" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="Virtual Surround Sound 7.1" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
                                                <TextBlock Text="Émulation d'enceintes virtuelles 3D dans votre casque" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkSpatialAudio" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ChkSpatialAudio_Checked" Unchecked="ChkSpatialAudio_Unchecked"/>
                                        </Grid>

                                        <Separator Background="#212839" Margin="0,0,0,16"/>

                                        <TextBlock Text="Gain de Réverbération Virtuelle :" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,10">
                                            <Slider x:Name="SliderReverbGain" Minimum="-12" Maximum="6" Value="-6" ValueChanged="SliderReverbGain_ValueChanged"/>
                                            <TextBlock x:Name="TxtReverbGainVal" Text="-6 dB" HorizontalAlignment="Right" Margin="0,-20,0,0" FontWeight="Bold" Foreground="#00B4D8"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========================================================= -->
                    <!-- TAB 6: PÉRIPHÉRIQUES AUDIO PHYSIQUES -->
                    <!-- ========================================================= -->
                    <TabItem x:Name="TabDevices" Header="🎧  Périphériques">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,10,0,20" MaxWidth="820" HorizontalAlignment="Center">
                                <TextBlock Text="🎧 Routage des Périphériques Audio Physiques" FontSize="16" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                <TextBlock Text="Configurez précisément le casque, les enceintes et le micro physique utilisés par chaque canal SonarGG." Foreground="#94A3B8" Margin="0,0,0,16"/>

                                <!-- Hardware Outputs Card -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="🔊 Sorties Matérielles Physiques (Casques &amp; Enceintes)" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14" Margin="0,0,0,14"/>

                                        <!-- Main / Game Output -->
                                        <TextBlock Text="🎧 Casque / Enceintes Principales (Jeu &amp; Sortie Générale) :" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ComboOutputDevice" Margin="0,0,0,14" SelectionChanged="ComboOutputDevice_SelectionChanged"/>

                                        <!-- Chat Output -->
                                        <TextBlock Text="💬 Sortie Dédiée Chat Vocal (Discord / Teams) :" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ComboChatOutputDevice" Margin="0,0,0,14" SelectionChanged="ComboChatOutputDevice_SelectionChanged"/>

                                        <!-- Media Output -->
                                        <TextBlock Text="🎵 Sortie Média / Musique (Spotify / Navigateurs) :" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ComboMediaOutputDevice" SelectionChanged="ComboMediaOutputDevice_SelectionChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Microphone Input Card -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="🎙️ Entrée Microphone Matériel Réel" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14" Margin="0,0,0,14"/>

                                        <TextBlock Text="🎙️ Microphone Physique Réel (Entrée voix) :" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ComboInputDevice" SelectionChanged="ComboInputDevice_SelectionChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Engine, Buffer & Tests Card -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Moteur Audio &amp; Outils de Test Immédiats" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14" Margin="0,0,0,14"/>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Buffer / Latency -->
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Latence &amp; Buffer Matériel :" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="ComboLatency">
                                                    <ComboBoxItem Content="⚡ Ultra-Faible (5 ms · 128 samples - eSports)"/>
                                                    <ComboBoxItem Content="🎯 Standard Studio (10 ms · 256 samples - Recommandé)" IsSelected="True"/>
                                                    <ComboBoxItem Content="🛡️ Haute Stabilité (20 ms · 512 samples)"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Sample Rate -->
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="Fréquence d'Échantillonnage :" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="ComboSampleRate">
                                                    <ComboBoxItem Content="48 000 Hz (24-bit Studio Gaming - Recommandé)" IsSelected="True"/>
                                                    <ComboBoxItem Content="44 100 Hz (16-bit Standard CD)"/>
                                                    <ComboBoxItem Content="96 000 Hz (32-bit Hi-Res Audio)"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Background="#212839" Margin="0,0,0,16"/>

                                        <!-- Audio Test Tools -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button x:Name="BtnTestAudioTone" Content="🔊 Tester le Son (Carillon Stéréo L/R)" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,14,0" Click="BtnTestAudioTone_Click"/>
                                            <Button x:Name="BtnTestMicMonitor" Content="🎧 Tester mon micro (Écoute)" Style="{StaticResource ActionButton}" Padding="16,8" Click="BtnTestMicMonitor_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========================================================= -->
                    <!-- TAB 7: PARAMÈTRES & SYSTÈME -->
                    <!-- ========================================================= -->
                    <TabItem x:Name="TabSettings" Header="⚙️  Paramètres">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,10,0,0" MaxWidth="820" HorizontalAlignment="Center">
                                <TextBlock Text="Options du Système &amp; Démarrage" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                <TextBlock Text="Configurez le comportement de SonarGG pour remplacer totalement SteelSeries GG." Foreground="#94A3B8" Margin="0,0,0,16"/>

                                <!-- Startup & Tray Options -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkAutoStart" Content="Démarrer SonarGG automatiquement au démarrage de Windows" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,14" Checked="ChkAutoStart_Checked" Unchecked="ChkAutoStart_Unchecked"/>
                                        <CheckBox x:Name="ChkMinimizeToTray" Content="Réduire dans la zone de notification (System Tray) au lieu de quitter" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,14" IsChecked="True"/>
                                        <CheckBox x:Name="ChkAutoPurgeGG" Content="Fermer automatiquement les processus SteelSeries d'origine au lancement" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" IsChecked="True"/>
                                    </StackPanel>
                                </Border>

                                <!-- Language Selector -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSettingsLangTitle" Text="Langue de l'interface (Interface Language)" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnLangFr" Content="🇫🇷 Français" Style="{StaticResource ActionButton}" Padding="16,8" Margin="0,0,10,0" Click="BtnLangFr_Click"/>
                                            <Button x:Name="BtnLangEn" Content="🇬🇧 English" Style="{StaticResource ActionButton}" Padding="16,8" Click="BtnLangEn_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- GitHub Auto-Updates Card -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtSettingsUpdateTitle" Text="🚀 Mises à Jour &amp; Version" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <Border Background="#1C2436" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtAppVersion" Text="v1.0.0" FontSize="11" FontWeight="Bold" Foreground="#FF6B00"/>
                                                </Border>
                                            </StackPanel>
                                            <Button x:Name="BtnCheckUpdates" Content="🔄 Vérifier les Mises à Jour" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Padding="14,6" FontSize="11" Click="BtnCheckUpdates_Click"/>
                                        </Grid>

                                        <TextBlock x:Name="TxtUpdateStatus" Text="Vous utilisez la version la plus récente de SonarGG." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,10"/>

                                        <!-- Update Action Banner (Visible when update detected) -->
                                        <Border x:Name="BorderUpdateAction" Background="#1D2335" BorderBrush="#FF5500" BorderThickness="1" CornerRadius="10" Padding="14" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtUpdateAvailableTitle" Text="🎉 Nouvelle mise à jour disponible !" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    <TextBlock x:Name="TxtUpdateChangelog" Text="Cliquez sur installer pour télécharger et mettre à jour automatiquement." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                                    <ProgressBar x:Name="ProgressDownload" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,8,14,0" Visibility="Collapsed" Background="#0C0F17" Foreground="#FF5500"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" x:Name="BtnInstallUpdate" Content="⚡ Installer la Mise à Jour" Style="{StaticResource PrimaryButton}" Padding="16,8" VerticalAlignment="Center" Click="BtnInstallUpdate_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Performance Metrics -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="Métriques de Performance" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Empreinte Mémoire RAM :" Foreground="#94A3B8"/>
                                            <TextBlock Text="~24 Mo (contre ~850 Mo pour SteelSeries GG)" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Consommation CPU :" Foreground="#94A3B8"/>
                                            <TextBlock Text="&lt; 0.1% (Processus DSP in-kernel direct)" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Latence Audio Estimée :" Foreground="#94A3B8"/>
                                            <TextBlock Text="0.18 ms" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========================================================= -->
                    <!-- TAB 8: RACCOURCIS CLAVIER GLOBAUX (HOTKEYS) -->
                    <!-- ========================================================= -->
                    <TabItem x:Name="TabShortcuts" Header="⌨️  Raccourcis">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,10,0,0" MaxWidth="820" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtHkHeader" Text="Raccourcis Clavier Globaux (En-Jeu &amp; Système)" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtHkSub" Text="Ces raccourcis fonctionnent en direct sans quitter votre jeu ou votre navigateur." Foreground="#94A3B8" Margin="0,0,0,16"/>

                                <!-- Status Card -->
