                    <!-- ========================================================= -->
                    <!-- TAB 1: MIXER -->
                    <!-- ========================================================= -->
                    <TabItem x:Name="TabMixer" Header="🎚️  Mixer">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,10,0,0">
                                <!-- Section Title -->
                                <Grid Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtMixerTitle" Text="Table de Mixage Virtuelle &amp; VU-Mètres Temps Réel" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    <TextBlock x:Name="TxtMixerSub" Text="Calcul balistique instantané · 60 FPS" HorizontalAlignment="Right" FontSize="11" Foreground="#64748B"/>
                                </Grid>

                                <!-- APPLICATION ROUTER -->
                                <Border Background="#121622" BorderBrush="#1F283B" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
