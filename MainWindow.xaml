                                                <Button x:Name="BtnScrollAppsLeft" Style="{StaticResource ActionButton}" Content="◀" Width="28" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="Défiler vers la gauche (ou molette)" Click="BtnScrollAppsLeft_Click"/>
                                                <Button x:Name="BtnScrollAppsRight" Style="{StaticResource ActionButton}" Content="▶" Width="28" Height="26" Padding="0" Margin="0,0,8,0" ToolTip="Défiler vers la droite (ou molette)" Click="BtnScrollAppsRight_Click"/>
                                                <Button x:Name="BtnRefreshApps" Style="{StaticResource ActionButton}" Content="🔄 Actualiser les apps" Padding="10,3" FontSize="11" Click="BtnRefreshApps_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Horizontal scrollable list of active running apps -->
                                        <ScrollViewer x:Name="ScrollApps" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollApps_PreviewMouseWheel" Padding="0,2,0,6">
