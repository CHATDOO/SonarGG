                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========================================================= -->
                    <!-- TAB 3: ÉGALISEUR & PROFILS -->
                    <!-- ========================================================= -->
                    <TabItem x:Name="TabEq" Header="🎛️  Égaliseur &amp; Profils">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,10,0,0">
                                <Grid Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Canal Cible :" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="ComboEqChannel" Width="140" Margin="0,0,20,0" SelectionChanged="ComboEqChannel_SelectionChanged">
                                            <ComboBoxItem Content="Jeu (Game)" Tag="Game" IsSelected="True"/>
                                            <ComboBoxItem Content="Chat Vocal" Tag="ChatRender"/>
                                            <ComboBoxItem Content="Média" Tag="Media"/>
                                            <ComboBoxItem Content="Auxiliaire" Tag="Aux"/>
                                        </ComboBox>

                                        <TextBlock Text="Profil Prédéfini :" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="ComboEqPresets" Width="260" Margin="0,0,14,0" SelectionChanged="ComboEqPresets_SelectionChanged"/>

