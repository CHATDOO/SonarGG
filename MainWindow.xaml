                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" x:Name="SliderMic" Style="{StaticResource VerticalSliderStyle}" Height="190" Minimum="0" Maximum="1" Value="1" ValueChanged="SliderMic_ValueChanged"/>
                                                <Border Grid.Column="1" Width="10" Height="190" Background="#0C0E14" CornerRadius="5" BorderBrush="#1C2333" BorderThickness="1" Margin="12,0,0,0">
                                                    <Grid VerticalAlignment="Bottom">
                                                        <Border x:Name="VuBarMic" Width="8" Height="0" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                    <GradientStop Color="#10B981" Offset="0.0"/>
                                                                    <GradientStop Color="#10B981" Offset="0.65"/>
                                                                    <GradientStop Color="#F59E0B" Offset="0.85"/>
                                                                    <GradientStop Color="#EF4444" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <Button x:Name="BtnMuteMic" Content="🔊 ACTIF" Style="{StaticResource MuteButton}" Width="95" Click="BtnMuteMic_Click"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========================================================= -->
                    <!-- TAB 2: CHATMIX -->
                    <!-- ========================================================= -->
                    <TabItem x:Name="TabChatMix" Header="⚖️  ChatMix">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,20,0,0" MaxWidth="720" HorizontalAlignment="Center">
                                <TextBlock Text="Équilibrage Vocal vs Jeu en Temps Réel" FontSize="16" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                                <TextBlock Text="Ajustez la balance entre le son de votre jeu et Discord. En plein jeu, utilisez le raccourci ou glissez le curseur." Foreground="#94A3B8" Margin="0,0,0,24"/>

                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="16" Padding="28" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,20">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <TextBlock Text="🎮 JEU" FontSize="14" FontWeight="Bold" Foreground="#FF6B1A" Margin="0,0,8,0"/>
                                                <TextBlock Text="(Focus Jeu)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtBalanceVal" Text="50% / 50%" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="(Focus Voix)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="CHAT 💬" FontSize="14" FontWeight="Bold" Foreground="#00B4D8"/>
                                            </StackPanel>
                                        </Grid>

                                        <Slider x:Name="SliderChatMix" Minimum="-1" Maximum="1" Value="0" Margin="0,0,0,24" ValueChanged="SliderChatMix_ValueChanged"/>

