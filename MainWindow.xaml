                                        </StackPanel>
                                    </Border>

                                    <!-- 3. MEDIA -->
                                    <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="12" Padding="14" Margin="5" Effect="{StaticResource CardShadow}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Background="#241B2E" BorderBrush="#3F2552" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,0,6" HorizontalAlignment="Center">
                                                <TextBlock x:Name="TxtMediaHeader" Text="🎵 MÉDIA" FontWeight="Bold" FontSize="11" Foreground="#C084FC"/>
                                            </Border>

                                            <!-- Assigned Apps Chips (Drop Target) -->
                                            <Border Background="#0C0F17" BorderBrush="#3F2552" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,8" MinHeight="42" MaxHeight="72" Width="175" AllowDrop="True" Drop="CardMedia_Drop" DragOver="Card_DragOver">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <WrapPanel x:Name="PanelAppsMedia" HorizontalAlignment="Center"/>
                                                </ScrollViewer>
                                            </Border>

                                            <TextBlock x:Name="TxtMediaCasqueVal" Text="100%" FontSize="24" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            
                                            <Grid Height="200" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" x:Name="SliderMediaCasque" Style="{StaticResource VerticalSliderStyle}" Height="190" Minimum="0" Maximum="1" Value="1" ValueChanged="SliderMediaCasque_ValueChanged"/>
                                                <Border Grid.Column="1" Width="10" Height="190" Background="#0C0E14" CornerRadius="5" BorderBrush="#1C2333" BorderThickness="1" Margin="12,0,0,0">
                                                    <Grid VerticalAlignment="Bottom">
                                                        <Border x:Name="VuBarMedia" Width="8" Height="0" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                    <GradientStop Color="#10B981" Offset="0.0"/>
                                                                    <GradientStop Color="#10B981" Offset="0.65"/>
                                                                    <GradientStop Color="#F59E0B" Offset="0.85"/>
                                                                    <GradientStop Color="#EF4444" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <Button x:Name="BtnMuteMedia" Content="🔊 ACTIF" Style="{StaticResource MuteButton}" Width="95" Click="BtnMuteMedia_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. AUX -->
                                    <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="12" Padding="14" Margin="5" Effect="{StaticResource CardShadow}">
