                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="16" Foreground="#10B981" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TxtHkStatus" Text="Raccourcis globaux Windows 11 actifs et enregistrés au niveau du système d'exploitation." FontWeight="SemiBold" Foreground="#10B981"/>
                                    </StackPanel>
                                </Border>

                                <!-- Shortcuts Grid (100% Personnalisable) -->
                                <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <!-- Row 1: Mute Mic -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#2E1B1B" BorderBrush="#4A2525" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                                                    <TextBlock Text="🎙️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtHkMicTitle" Text="Couper / Activer le Microphone (Mute Mic)" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="TxtHkMicDesc" Text="Bascule instantanément la coupure du micro pour Discord et les jeux" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnHkMic" HorizontalAlignment="Right" Style="{StaticResource HotkeyEditBtn}" Content="Ctrl + Shift + M" Tag="ToggleMuteMic" Click="BtnEditHotkey_Click"/>
                                        </Grid>

                                        <Separator Background="#1C2333" Margin="0,4,0,12"/>

                                        <!-- Row 2: Mute Game -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#2B1D16" BorderBrush="#4A2616" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                                                    <TextBlock Text="🎮" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtHkGameTitle" Text="Couper / Activer le Son du Jeu (Gaming)" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="TxtHkGameDesc" Text="Mute le canal Jeu Sonar sans toucher au chat vocal" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnHkGame" HorizontalAlignment="Right" Style="{StaticResource HotkeyEditBtn}" Content="Ctrl + Shift + G" Tag="ToggleMuteGame" Click="BtnEditHotkey_Click"/>
                                        </Grid>

                                        <Separator Background="#1C2333" Margin="0,4,0,12"/>

                                        <!-- Row 3: Mute Chat -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#132433" BorderBrush="#183B4F" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                                                    <TextBlock Text="💬" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtHkChatTitle" Text="Couper / Activer le Chat Vocal (Voice Chat)" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="TxtHkChatDesc" Text="Coupe le son des coéquipiers Discord ou du jeu" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnHkChat" HorizontalAlignment="Right" Style="{StaticResource HotkeyEditBtn}" Content="Ctrl + Shift + C" Tag="ToggleMuteChat" Click="BtnEditHotkey_Click"/>
                                        </Grid>

                                        <Separator Background="#1C2333" Margin="0,4,0,12"/>

                                        <!-- Row 4: Mute Media -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#241B2E" BorderBrush="#3F2552" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                                                    <TextBlock Text="🎵" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtHkMediaTitle" Text="Couper / Activer la Musique (Media / Spotify)" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="TxtHkMediaDesc" Text="Silence immédiat pour Spotify, YouTube ou Chrome" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnHkMedia" HorizontalAlignment="Right" Style="{StaticResource HotkeyEditBtn}" Content="Ctrl + Shift + D" Tag="ToggleMuteMedia" Click="BtnEditHotkey_Click"/>
                                        </Grid>

                                        <Separator Background="#1C2333" Margin="0,4,0,12"/>

                                        <!-- Row 5: Mute Aux -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#162923" BorderBrush="#1F4739" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                                                    <TextBlock Text="🎧" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtHkAuxTitle" Text="Couper / Activer le Canal Auxiliaire (Aux)" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="TxtHkAuxDesc" Text="Mute rapide du canal secondaire ou des alertes OBS" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnHkAux" HorizontalAlignment="Right" Style="{StaticResource HotkeyEditBtn}" Content="Ctrl + Shift + A" Tag="ToggleMuteAux" Click="BtnEditHotkey_Click"/>
                                        </Grid>

                                        <Separator Background="#1C2333" Margin="0,4,0,12"/>

                                        <!-- Row 6: Mini Mode Toggle -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#2B1D16" BorderBrush="#4A2616" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                                                    <TextBlock Text="📱" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtHkMiniTitle" Text="Basculer Mode Mini &lt;-&gt; Mode Studio Pro" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="TxtHkMiniDesc" Text="Passe instantanément d'une vue à l'autre en un éclair" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnHkMini" HorizontalAlignment="Right" Style="{StaticResource HotkeyEditBtn}" Content="Ctrl + M" Tag="ToggleMiniMode" Click="BtnEditHotkey_Click"/>
                                        </Grid>

                                        <Separator Background="#1C2333" Margin="0,4,0,12"/>

                                        <!-- Row 7: Volume Up -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#1C2436" BorderBrush="#2F3E5E" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                                                    <TextBlock Text="🔊" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtHkVolUpTitle" Text="Volume Général (+5%)" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="TxtHkVolUpDesc" Text="Augmente le son principal sans quitter votre jeu" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnHkVolUp" HorizontalAlignment="Right" Style="{StaticResource HotkeyEditBtn}" Content="Ctrl + Alt + Up" Tag="VolumeUp" Click="BtnEditHotkey_Click"/>
                                        </Grid>

                                        <Separator Background="#1C2333" Margin="0,4,0,12"/>

                                        <!-- Row 8: Volume Down -->
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#1C2436" BorderBrush="#2F3E5E" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                                                    <TextBlock Text="🔉" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtHkVolDownTitle" Text="Volume Général (-5%)" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock x:Name="TxtHkVolDownDesc" Text="Diminue le son principal sans quitter votre jeu" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnHkVolDown" HorizontalAlignment="Right" Style="{StaticResource HotkeyEditBtn}" Content="Ctrl + Alt + Down" Tag="VolumeDown" Click="BtnEditHotkey_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Help notice + Reset button -->
                                <Grid Margin="4,16,4,0">
                                    <TextBlock x:Name="TxtHkClickHelp" Text="💡 Cliquez sur un raccourci pour le modifier, puis appuyez sur vos nouvelles touches (ou Échap pour annuler)." FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnResetHotkeys" Content="🔄 Réinitialiser par défaut" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Padding="14,6" Click="BtnResetHotkeys_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Grid>

            <!-- ============================================================= -->
            <!-- MINI VIEW CONTAINER (MODE MINI FLOTTANT / COMPACT) -->
            <!-- ============================================================= -->
            <Grid x:Name="MiniViewContainer" Visibility="Collapsed" Background="#0C0F17">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/> <!-- Mini Titlebar -->
                    <RowDefinition Height="*"/>  <!-- 5 Channel Rows -->
                    <RowDefinition Height="38"/> <!-- Mini Footer: ChatMix & Master -->
                </Grid.RowDefinitions>

                <!-- Mini Titlebar -->
                <Grid Grid.Row="0" Background="#111622">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border Width="20" Height="20" Background="#FF5500" CornerRadius="5" Margin="0,0,6,0">
                            <TextBlock Text="⚡" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SONAR" FontWeight="Black" FontSize="12" Foreground="White" Margin="0,0,2,0"/>
                        <TextBlock Text="GG" FontWeight="Black" FontSize="12" Foreground="#FF5500" Margin="0,0,6,0"/>
                        <Border Background="#1C2436" CornerRadius="4" Padding="5,1">
                            <TextBlock x:Name="TxtMiniBadge" Text="MINI" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>

                    <!-- Caption buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin Button (Always on Top) -->
                        <ToggleButton x:Name="BtnPinMini" Style="{StaticResource MiniIconToggle}" Content="📌" ToolTip="Garder au premier plan (Always on top)" Click="BtnPinMini_Click"/>
                        <!-- Lang Toggle -->
                        <Button x:Name="BtnMiniLang" Style="{StaticResource MiniCaptionButton}" Content="FR" ToolTip="Changer de langue (FR / EN)" Click="BtnLangToggle_Click"/>
                        <!-- Restore to Pro Mode -->
                        <Button x:Name="BtnRestorePro" Style="{StaticResource MiniCaptionButton}" Content="🗖" ToolTip="Agrandir en mode Studio Pro (Ctrl+M)" Click="BtnRestorePro_Click"/>
                        <!-- Minimize -->
                        <Button Style="{StaticResource MiniCaptionButton}" Content="—" Click="BtnMinimize_Click"/>
                        <!-- Close -->
                        <Button Style="{StaticResource CloseCaptionButton}" Width="36" Height="36" Content="✕" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 5 Compact Channel Rows -->
                <Grid Grid.Row="1" Margin="12,6,12,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. GAME -->
                    <Grid Grid.Row="0" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtMiniGameLbl" Text="Jeu" FontSize="11" FontWeight="Bold" Foreground="#FF6B1A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                            <ProgressBar x:Name="MiniVuGame" IsHitTestVisible="False" Height="3" Background="#141824" Foreground="#10B981" BorderThickness="0" VerticalAlignment="Bottom" Margin="0,0,0,-4" Maximum="1" Value="0"/>
                            <Slider x:Name="MiniSliderGame" Minimum="0" Maximum="1" Value="1" ValueChanged="MiniSliderGame_ValueChanged"/>
                        </Grid>
                        <TextBlock Grid.Column="2" x:Name="TxtMiniGameVal" Text="100%" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button Grid.Column="3" x:Name="MiniBtnMuteGame" Content="🔊" Width="28" Height="24" Style="{StaticResource MiniMuteBtn}" Click="BtnMuteGame_Click"/>
                    </Grid>

                    <!-- 2. CHAT -->
                    <Grid Grid.Row="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💬" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtMiniChatLbl" Text="Chat" FontSize="11" FontWeight="Bold" Foreground="#00B4D8" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                            <ProgressBar x:Name="MiniVuChat" IsHitTestVisible="False" Height="3" Background="#141824" Foreground="#10B981" BorderThickness="0" VerticalAlignment="Bottom" Margin="0,0,0,-4" Maximum="1" Value="0"/>
                            <Slider x:Name="MiniSliderChat" Minimum="0" Maximum="1" Value="1" ValueChanged="MiniSliderChat_ValueChanged"/>
                        </Grid>
                        <TextBlock Grid.Column="2" x:Name="TxtMiniChatVal" Text="100%" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button Grid.Column="3" x:Name="MiniBtnMuteChat" Content="🔊" Width="28" Height="24" Style="{StaticResource MiniMuteBtn}" Click="BtnMuteChat_Click"/>
                    </Grid>

                    <!-- 3. MEDIA -->
                    <Grid Grid.Row="2" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎵" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtMiniMediaLbl" Text="Média" FontSize="11" FontWeight="Bold" Foreground="#C084FC" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                            <ProgressBar x:Name="MiniVuMedia" IsHitTestVisible="False" Height="3" Background="#141824" Foreground="#10B981" BorderThickness="0" VerticalAlignment="Bottom" Margin="0,0,0,-4" Maximum="1" Value="0"/>
                            <Slider x:Name="MiniSliderMedia" Minimum="0" Maximum="1" Value="1" ValueChanged="MiniSliderMedia_ValueChanged"/>
                        </Grid>
                        <TextBlock Grid.Column="2" x:Name="TxtMiniMediaVal" Text="100%" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button Grid.Column="3" x:Name="MiniBtnMuteMedia" Content="🔊" Width="28" Height="24" Style="{StaticResource MiniMuteBtn}" Click="BtnMuteMedia_Click"/>
                    </Grid>

                    <!-- 4. AUX -->
                    <Grid Grid.Row="3" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎧" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtMiniAuxLbl" Text="Aux" FontSize="11" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                            <ProgressBar x:Name="MiniVuAux" IsHitTestVisible="False" Height="3" Background="#141824" Foreground="#10B981" BorderThickness="0" VerticalAlignment="Bottom" Margin="0,0,0,-4" Maximum="1" Value="0"/>
                            <Slider x:Name="MiniSliderAux" Minimum="0" Maximum="1" Value="1" ValueChanged="MiniSliderAux_ValueChanged"/>
                        </Grid>
                        <TextBlock Grid.Column="2" x:Name="TxtMiniAuxVal" Text="100%" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button Grid.Column="3" x:Name="MiniBtnMuteAux" Content="🔊" Width="28" Height="24" Style="{StaticResource MiniMuteBtn}" Click="BtnMuteAux_Click"/>
                    </Grid>

                    <!-- 5. MIC -->
                    <Grid Grid.Row="4" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎙️" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtMiniMicLbl" Text="Micro" FontSize="11" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                            <ProgressBar x:Name="MiniVuMic" IsHitTestVisible="False" Height="3" Background="#141824" Foreground="#10B981" BorderThickness="0" VerticalAlignment="Bottom" Margin="0,0,0,-4" Maximum="1" Value="0"/>
                            <Slider x:Name="MiniSliderMic" Minimum="0" Maximum="1" Value="1" ValueChanged="MiniSliderMic_ValueChanged"/>
                        </Grid>
                        <TextBlock Grid.Column="2" x:Name="TxtMiniMicVal" Text="100%" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button Grid.Column="3" x:Name="MiniBtnMuteMic" Content="🔊" Width="28" Height="24" Style="{StaticResource MiniMuteBtn}" Click="BtnMuteMic_Click"/>
                    </Grid>
                </Grid>

                <!-- Mini Footer: ChatMix Balance -->
                <Grid Grid.Row="2" Background="#0A0D14" Margin="8,0,8,6">
                    <Border Background="#121722" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="6" Padding="8,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🎮 50%" FontSize="10" FontWeight="Bold" Foreground="#FF6B1A" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="MiniSliderChatMix" Minimum="-1" Maximum="1" Value="0" VerticalAlignment="Center" Margin="8,0" ValueChanged="MiniSliderChatMix_ValueChanged"/>
                            <TextBlock Grid.Column="2" Text="50% 💬" FontSize="10" FontWeight="Bold" Foreground="#00B4D8" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
