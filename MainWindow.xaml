                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- 5 Channel Strips Grid -->
                                <UniformGrid Columns="5" Margin="0,0,0,16">

                                    <!-- 1. GAME -->
                                    <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="12" Padding="14" Margin="5" Effect="{StaticResource CardShadow}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Background="#2B1D16" BorderBrush="#4A2616" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,0,6" HorizontalAlignment="Center">
                                                <TextBlock x:Name="TxtGameHeader" Text="🎮 JEU (GAME)" FontWeight="Bold" FontSize="11" Foreground="#FF6B1A"/>
                                            </Border>

                                            <!-- Assigned Apps Chips (Drop Target) -->
                                            <Border Background="#0C0F17" BorderBrush="#2B1D16" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,8" MinHeight="42" MaxHeight="72" Width="175" AllowDrop="True" Drop="CardGame_Drop" DragOver="Card_DragOver">
