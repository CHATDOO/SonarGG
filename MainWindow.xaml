                                            </Border>

                                            <!-- Assigned Apps Chips (Drop Target) -->
                                            <Border Background="#0C0F17" BorderBrush="#1F4739" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,8" MinHeight="42" MaxHeight="72" Width="175" AllowDrop="True" Drop="CardAux_Drop" DragOver="Card_DragOver">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <WrapPanel x:Name="PanelAppsAux" HorizontalAlignment="Center"/>
                                                </ScrollViewer>
                                            </Border>

                                            <TextBlock x:Name="TxtAuxCasqueVal" Text="100%" FontSize="24" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            
                                            <Grid Height="200" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" x:Name="SliderAuxCasque" Style="{StaticResource VerticalSliderStyle}" Height="190" Minimum="0" Maximum="1" Value="1" ValueChanged="SliderAuxCasque_ValueChanged"/>
                                                <Border Grid.Column="1" Width="10" Height="190" Background="#0C0E14" CornerRadius="5" BorderBrush="#1C2333" BorderThickness="1" Margin="12,0,0,0">
                                                    <Grid VerticalAlignment="Bottom">
                                                        <Border x:Name="VuBarAux" Width="8" Height="0" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                    <GradientStop Color="#10B981" Offset="0.0"/>
                                                                    <GradientStop Color="#10B981" Offset="0.65"/>
                                                                    <GradientStop Color="#F59E0B" Offset="0.85"/>
                                                                    <GradientStop Color="#EF4444" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <Button x:Name="BtnMuteAux" Content="🔊 ACTIF" Style="{StaticResource MuteButton}" Width="95" Click="BtnMuteAux_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 5. MICROPHONE -->
                                    <Border Background="#141824" BorderBrush="#212839" BorderThickness="1" CornerRadius="12" Padding="14" Margin="5" Effect="{StaticResource CardShadow}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Background="#2B1414" BorderBrush="#4A1E1E" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,0,6" HorizontalAlignment="Center">
                                                <TextBlock x:Name="TxtMicHeader" Text="🎙️ MICROPHONE" FontWeight="Bold" FontSize="11" Foreground="#EF4444"/>
                                            </Border>

